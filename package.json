{
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	},
	"scripts": {
		"dev": "vp dev",
		"preview": "vp preview",
		"build": "vp build",
		"prepare": "concurrently --group --prefix-colors 'auto' 'pnpm:prepare:*'",
		"prepare:hooks": "vp config --no-agent",
		"lint": "concurrently --group --prefix-colors 'auto' 'pnpm:lint:*'",
		"lint:eslint": "eslint .",
		"lint:types": "vue-tsc --noEmit",
		"lint:cspell": "cspell --no-progress --no-summary --no-must-find-files .",
		"lint:knip": "knip --no-progress",
		"fix": "concurrently --group --prefix-colors 'auto' 'pnpm:fix:*'",
		"fix:eslint": "eslint --fix .",
		"fix:knip": "knip --fix --no-progress --workspace ."
	},
	"dependencies": {
		"@unocss/reset": "^66.0.0",
		"vue": "^3.5.13",
		"vue-router": "^5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@somehow-digital/commitlint-config": "^1.0.0",
		"@somehow-digital/cspell-dictionary": "^2.7.0",
		"@somehow-digital/eslint-config": "^5.0.0",
		"@somehow-digital/typescript-config": "^3.0.0",
		"@somehow-digital/unocss-preset": "^2.0.0",
		"@tsconfig/node24": "^24.0.0",
		"@types/node": "^24.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/tsconfig": "^0.9.0",
		"concurrently": "^10.0.0",
		"cspell": "^10.0.0",
		"eslint": "^10.0.0",
		"jiti": "^2.4.2",
		"knip": "^6.0.0",
		"typescript": "^6.0.0",
		"unocss": "^66.0.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plugin-vue-devtools": "^8.0.0",
		"vite-plus": "1.4.0",
		"vue-tsc": "^3.0.0"
	}
}
